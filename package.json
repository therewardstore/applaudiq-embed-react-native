{
  "name": "@applaudiq/embed-react-native",
  "version": "1.3.0",
  "description": "React Native SDK to embed the Applaud IQ recognition portal (auto + manual login, native SSO). Works with bare React Native and Expo.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf lib",
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "release": "release-it",
    "audit:deps": "pnpm audit --audit-level=moderate"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react-native",
    "expo",
    "applaudiq",
    "embed",
    "sso",
    "webview",
    "recognition"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therewardstore/applaudiq-embed-react-native.git"
  },
  "homepage": "https://github.com/therewardstore/applaudiq-embed-react-native#readme",
  "bugs": {
    "url": "https://github.com/therewardstore/applaudiq-embed-react-native/issues"
  },
  "author": "Arulraj V <arulraj@vananam.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.71",
    "react-native-webview": ">=13"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "react-native-webview": "13.8.6",
    "release-it": "^20.2.1",
    "typescript": "^5.4.0",
    "husky": "^9.1.7"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "basic-ftp": "^6.2.1",
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "react-native>@react-native-community/cli": "-",
      "react-native>@react-native-community/cli-platform-android": "-",
      "react-native>@react-native-community/cli-platform-ios": "-",
      "react-native>@react-native/codegen": "-",
      "react-native>@react-native/community-cli-plugin": "-",
      "react-native>jest-environment-node": "-"
    },
    "auditConfig": {
      "ignoreGhsas": []
    }
  }
}
